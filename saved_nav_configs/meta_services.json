{
  "services": [
    {
      "name": "meta.localization",
      "startup": true,
      "deactivate_after_step": false,
      "config": {
        "map_folder": "map_default",
        "map_name": "map_default.pcd",
        "map_optimize_en": false,
        "lidar_topic": "/livox/lidar",
        "imu_topic": "/livox/imu",
        "auto_relocalization": true,
        "voxel_size": 0.2
      }
    },
    {
      "name": "meta.astribot_navigation",
      "startup": true,
      "deactivate_after_step": false,
      "config": {
        "map_path": "",
        "max_linear_velocity": 0.3,
        "max_angular_velocity": 0.5,
        "safety_distance": 0.4,
        "planning_frequency": 5,
        "control_frequency": 10
      }
    },
    {
      "name": "meta.lidar",
      "startup": false,
      "deactivate_after_step": false,
      "config": {
        "user_config_path": "",
        "publish_freq": 10,
        "xfer_format": 0,
        "multi_topic": 1,
        "data_src": 0,
        "output_data_type": 0,
        "frame_id": "livox_frame"
      }
    },
    {
      "name": "meta.detection",
      "startup": false,
      "deactivate_after_step": false,
      "config": {
        "simulated": true
      }
    },
    {
      "name": "meta.sales_replay",
      "startup": false,
      "deactivate_after_step": false,
      "config": {}
    },
    {
      "name": "meta.camera",
      "startup": false,
      "deactivate_after_step": false,
      "config": {}
    },
    {
      "name": "meta.astribot_dock",
      "startup": false,
      "deactivate_after_step": false,
      "config": {
        "dock_config_path": "",
        "prepose_distance": 0.6,
        "align_position_threshold": 0.02,
        "align_yaw_threshold": 0.05,
        "charging_current_threshold": 0.1,
        "low_battery_threshold": 15
      }
    }
  ]
}